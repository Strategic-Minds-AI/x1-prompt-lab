{
  "name": "LocalCommand",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Which local bridge this command is for"
    },
    "type": {
      "type": "string",
      "enum": [
        "operation",
        "shell",
        "scan",
        "ingest",
        "organize",
        "proxy"
      ]
    },
    "command": {
      "type": "string",
      "description": "Allowlisted typed operation ID, folder/file path for scan or ingest, or local Ollama URL for proxy"
    },
    "args": {
      "type": "object",
      "description": "Validated operation arguments (model for Ollama operations), mapping/root for organize, or method/headers/body for local Ollama proxy"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "failed"
      ],
      "default": "pending"
    },
    "output": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "type",
    "command"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}