        "delete",
        "read"
      ]
    },
    {
      "function_name": "bridgeStatus",
      "description": "Check which local bridges are online"
    },
    {
      "function_name": "bridgeCommand",
      "description": "Run a shell/scan/ingest/organize command on the local machine"
    },
    {
      "function_name": "bridgeProxy",
      "description": "Tunnel an HTTP request to a localhost service (e.g. Ollama API)"
    },
    {
      "function_name": "sendWhatsApp",
      "description": "Send a WhatsApp message to the owner via Twilio"
    },
    {
      "function_name": "syncPromptToDrive",
      "description": "Back up a prompt or result to Google Drive"
    }
  ],
